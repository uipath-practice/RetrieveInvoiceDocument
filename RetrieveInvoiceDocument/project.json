    {
      "filePath": "Main.xaml",
      "uniqueId": "a3f1c6d2-7e9b-4c5a-8d2f-6b4e1a0c9d38",
      "input": [
        {
          "name": "in_Discrepancy",
          "displayName": "in_Discrepancy",
          "tooltip": "A discrepancy id to plant: VENDOR_MISMATCH, TAX_RATE_MISMATCH, EXTRA_LINE_PACKAGING, EXTRA_LINE_UNORDERED, DESCRIPTION_SYNONYM, DESCRIPTION_DIFFERENT_ITEM (the six the probability draw uses), FORMATTING_ONLY (a green case) or PO_NUMBER_UNKNOWN (a red case; never drawn). 'none' = a clean pair; empty = draw by in_DiscrepancyProbability. Other ids in the catalogue exist for the course's tests only; an unknown id fails the job.",
          "type": "System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e",
          "required": false,
          "hasDefault": true,
          "isExpression": false,
          "defaultValue": ""
        },
        {
          "name": "in_DiscrepancyProbability",
          "displayName": "in_DiscrepancyProbability",
          "tooltip": "0-100: the chance that an unpinned invoice carries one discrepancy from the exercise set. Default 20.",
          "type": "System.Int32, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e",
          "required": false,
          "hasDefault": true,
          "isExpression": false,
          "defaultValue": "20"
        },
        {
          "name": "in_Seed",
          "displayName": "in_Seed",
          "tooltip": "Non-zero reproduces the same invoice and purchase order; 0 draws a fresh seed, recorded in the answer key.",
          "type": "System.Int32, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e",
          "required": false,
          "hasDefault": true,
          "isExpression": false,
          "defaultValue": "0"
        },
        {
          "name": "in_LinesQuantity",
          "displayName": "in_LinesQuantity",
          "tooltip": "Lines on the purchase order, 2-8. Default 4.",
          "type": "System.Int32, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e",
          "required": false,
          "hasDefault": true,
          "isExpression": false,
          "defaultValue": "4"
        }
      ],
      "output": [
        {
          "name": "out_InvoiceFileName",
          "displayName": "out_InvoiceFileName",
          "tooltip": "The invoice PDF's name in storage bucket InvoicesStorage, e.g. INV-22150825.pdf",
          "type": "System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e"
        },
        {
          "name": "out_InvoiceNumber",
          "displayName": "out_InvoiceNumber",
          "tooltip": "INV-<8 digits>",
          "type": "System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e"
        },
        {
          "name": "out_PONumber",
          "displayName": "out_PONumber",
          "tooltip": "PO-<8 digits>: the key of the PurchaseOrders row the generator wrote",
          "type": "System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e"
        }
      ]
    }
  ],
